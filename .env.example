# Copia este archivo a ".env" (NO lo subas a GitHub) y completa los valores.
# Es el mismo conjunto de variables que se configurará en AWS.

# Base de datos MySQL
DB_URL=jdbc:mysql://localhost:3306/disgas?serverTimezone=America/Santiago
DB_USERNAME=disgas
DB_PASSWORD=cambia-esta-clave

# Clave de firma de los JWT (mínimo 32 caracteres). Genera una con:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-caracteres-o-mas

# Orígenes permitidos (frontend). Separar con comas. Ej.: https://TU_USUARIO.github.io
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Primer administrador (se crea solo si aún no existe ninguno)
ADMIN_EMAIL=admin@volcan.cl
ADMIN_PASSWORD=cambia-esta-clave-admin

# Solo para docker-compose local (contraseñas del contenedor MySQL)
MYSQL_ROOT_PASSWORD=cambia-root
